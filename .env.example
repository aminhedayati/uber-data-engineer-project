# Azure Event Hubs credentials for the producer application.
# Copy this file to .env and fill in the values from your Event Hub namespace.
# .env is git-ignored - never commit real credentials.

# Namespace-level connection string, including the SharedAccessKey.
# Azure portal -> Event Hubs namespace -> Shared access policies -> <policy> -> Connection string
# The policy needs Send rights.
CONNECTION_STRING="Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<policy>;SharedAccessKey=<key>"

# Name of the event hub (topic) inside that namespace.
EVENT_HUBNAME="ubertopic"
